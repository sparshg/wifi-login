<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The settings file holds the Wi-Fi password: never back it up or transfer it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="settings" />
        <exclude domain="sharedpref" path="dev.sparshg.bitslogin.pref.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="settings" />
        <exclude domain="sharedpref" path="dev.sparshg.bitslogin.pref.xml" />
    </device-transfer>
</data-extraction-rules>
